<div id="log">
  <ul>
    {% for item in changelog %}
      <li>{{ item.date }}:
        <br/>
        {{ item.text }}</li>
    {% endfor %}
  </ul>
</div>

<style>
  li {
    list-style: none;
    text-align: left;
    line-height: 1.5;
  }

  #log {
    height: 200px;
    overflow-y: scroll;
  }
</style>
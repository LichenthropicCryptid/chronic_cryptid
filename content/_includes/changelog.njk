<div id="log">
  <ul>
    {% for item in changelog %}
      <li>{{ item.date }}:
        <br/>
        {{ item.text }}
      </li>
    {% endfor %}
  </ul>
</div>

<style>
  li {
    list-style: none;
    line-height: 1.5;
    padding: 10px;
  }

  #log {
    align-content: left;
    height: 200px;
    overflow-y: scroll;
    overflow-x: hidden;
    text-align: left;
  }
</style>
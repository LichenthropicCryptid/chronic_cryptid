<div class="sidebar">
    <div class="container" id="changelog-container">

        <button class="changelog-button" style="text-align:center">
            CHANGELOG
        </button>

            <script type="text/javascript">
                $(function() {
                    $(".changelog-button").on("click", function() {
                    $(".hidden-changelog").slideToggle();
                    });
                });
            </script>        
                <span class="hidden-changelog">
                    {% include 'changelog.njk' %}
                </span>  
    </div>
    <h2 style="text-align:center;">Tunes</h2>

    <div class="container" id="boombox-container">

        <button class="boombox" style="text-align:center" title="click here for music">
            <span class="motion-toggle">
                <img id="boombox-button" src="../assets/custom assets/boombox.gif" alt="button that reads boombox">
            </span>
        </button>
            <script type="text/javascript">

                $(function () {
                    $(".boombox").on("click", function (e) {
                        window.open("https://lichenthropic.neocities.org/pages/mp3", "_blank",
                        "left=-550,top=0,width=600px,height=300px,padding=0");
                     });
                 });

            </script>
        <img id="mp3-boombox" src="https://lichenthropic.neocities.org/images/assets/boombox.png" width="100%;">
                        
</div>

<div class="container" id="clock-container">

    <h2 style="text-align:center;">Its 420 somewhere!</h2>
    <iframe class="date-time" src="https://free.timeanddate.com/clock/iakw1nd7/n1091/tlca/fn8/fs18/fc090/tc000/pct/ftb/bas5/bat7/bac390/pa10/tt0/tw1/tm1/td2/th2/ta1/tb4" frameborder="0" width="100%"allowtransparency="true"></iframe>

</div>

<div class="container" id="moon-container">

    <h2 style="text-align:center;">
        Take a toke, you deserve it
    </h2>
        <ws-widget class="click" type="weather" iid="4230" width="100%" height="100%"></ws-widget>

</div>

<div class="container" id="visitors-container">

<h2 style="text-align:center;">VISITORS</h2>
    <a class="click" href="http://www.hit-counter.net">
        <img src="http://www.hit-counter.net/counter.php?action=count&style=crt&padding=10&id=lichenthropic.neocities" alt="Hit counter">
    </a>

</div>

    <div style="text-align: center; margin-top: 25px;">
        {% include 'zodiac.njk' %}
    </div>

</div>
